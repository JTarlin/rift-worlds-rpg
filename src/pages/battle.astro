---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Battle Map" description="Build a hex-zone battlefield, deploy two teams, roll dice, and track a Rift Worlds encounter.">
  <SiteHeader />
  <main id="main-content" class="shell battle-page">
    <header class="battle-heading">
      <div>
        <p class="eyebrow">Tactical workspace</p>
        <h1>Battle Map</h1>
        <p class="lede">Paint zones onto the hex grid, deploy two teams, and run a complete local encounter.</p>
      </div>
      <div class="battle-file-actions">
        <a class="button secondary" href="#map-library">Map library</a>
        <button class="button secondary" id="new-battle" type="button">New session</button>
        <button class="button primary" id="save-battle" type="button">Save session</button>
      </div>
    </header>

    <section class="battle-toolbar">
      <div class="workflow-switcher">
        <span class="toolbar-label">Workflow</span>
        <div class="segmented">
          <button type="button" class="active" data-mode="paint">1. Build map</button>
          <button type="button" data-mode="deploy">2. Deploy teams</button>
          <button type="button" data-mode="play">3. Play match</button>
        </div>
      </div>
      <div class="terrain-controls">
        <label>Terrain color<input id="zone-color" type="color" value="#28705b" /></label>
        <label>Zone name<input id="zone-name" maxlength="30" value="Riftwood" /></label>
        <button class="text-button" id="erase-toggle" type="button">Eraser off</button>
      </div>
      <span class="battle-status" id="battle-status">Paint connected hexes to define battlefield zones.</span>
    </section>

    <div class="battle-layout">
      <section class="map-panel">
        <div class="map-frame">
          <div class="map-compass" aria-hidden="true">N</div>
          <div class="hex-map" id="hex-map" aria-label="Battle map hex grid"></div>
        </div>
        <div class="map-library" id="map-library">
          <div class="panel-title"><div><p class="eyebrow">Terrain archive</p><h2>Saved maps</h2></div></div>
          <div class="map-save-row">
            <label>Map name<input id="map-name" maxlength="60" /></label>
            <button class="button secondary" id="save-map" type="button">Save map</button>
          </div>
          <div class="saved-map-list" id="saved-map-list"></div>
        </div>
      </section>

      <aside class="battle-sidebar">
        <section class="battle-card" id="deployment-panel">
          <div class="panel-title"><div><p class="eyebrow">Deployment</p><h2>Teams</h2></div></div>
          <div class="team-tabs">
            <button class="team-a active" type="button" data-team="A">Team A</button>
            <button class="team-b" type="button" data-team="B">Team B</button>
          </div>
          <label>Choose unit<select id="unit-template"></select></label>
          <button class="button secondary full-button" id="select-unit" type="button">Ready unit for placement</button>
          <div class="team-rosters">
            <div><h3>Team A</h3><ul id="team-a-list"></ul></div>
            <div><h3>Team B</h3><ul id="team-b-list"></ul></div>
          </div>
        </section>

        <section class="battle-card">
          <div class="panel-title"><div><p class="eyebrow">Round control</p><h2>Turn tracker</h2></div><strong id="round-label">Round 1</strong></div>
          <div class="initiative-list" id="initiative-list"></div>
          <div class="turn-buttons">
            <button class="button secondary" id="start-match" type="button">Roll initiative</button>
            <button class="button primary" id="next-turn" type="button">Next turn</button>
          </div>
        </section>

        <section class="battle-card dice-card">
          <div class="panel-title"><div><p class="eyebrow">Resolution</p><h2>Dice roller</h2></div></div>
          <div class="dice-controls">
            <label>Skill bonus<input id="roll-bonus" type="number" value="0" /></label>
            <label class="check-label"><input id="roll-advantage" type="checkbox" /> Advantage</label>
          </div>
          <button class="button primary full-button" id="roll-dice" type="button">Roll 2d6</button>
          <div class="dice-result" id="dice-result" aria-live="polite">—</div>
          <ol class="roll-log" id="roll-log"></ol>
        </section>

        <section class="battle-card selected-card">
          <div class="panel-title"><div><p class="eyebrow">Active piece</p><h2 id="selected-name">No unit selected</h2></div></div>
          <div id="selected-unit"><p class="storage-note">Choose a deployed unit to view its skills, perks, health, and actions.</p></div>
        </section>
        <section class="battle-card match-log-card">
          <div class="panel-title"><div><p class="eyebrow">Match record</p><h2>Activity</h2></div></div>
          <ol class="match-log" id="match-log"></ol>
        </section>
      </aside>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { characterTemplates, type CharacterTemplate } from "../data/templates";
  type Mode = "paint" | "deploy" | "play";
  type Team = "A" | "B";
  type Cell = { index: number; zone: string; color: string };
  type Unit = CharacterTemplate & { id: string; team: Team; cell: number; currentHealth: number; actionsUsed: number; initiative: number };
  const storageKey = "rift-worlds-battle-v1";
  const mapsKey = "rift-worlds-maps-v1";
  const rosterKey = "rift-worlds-character-roster-v1";
  const map = document.getElementById("hex-map") as HTMLElement;
  const cells: Cell[] = Array.from({ length: 96 }, (_, index) => ({ index, zone: "", color: "" }));
  let mode: Mode = "paint";
  let team: Team = "A";
  let erasing = false;
  let pendingTemplate: CharacterTemplate | null = null;
  let units: Unit[] = [];
  let selectedUnitId = "";
  let initiative: string[] = [];
  let turnIndex = 0;
  let round = 1;
  let pointerPainting = false;
  let movesRemaining = 0;

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const healthFor = (unit: CharacterTemplate) => Math.ceil(unit.level / 2) + unit.healthPerks * 3;
  const actionsFor = (unit: CharacterTemplate) => 1 + (unit.perks.find((perk) => perk.name === "Action")?.ranks || 0);
  const movementFor = (unit: CharacterTemplate) => 1 + (unit.perks.find((perk) => perk.name === "Speed")?.ranks || 0);
  const perkRules: Record<string, string> = {
    Energy: "Gain +3 maximum energy per rank.",
    Recuperation: "Recover +2 additional energy at the end of each turn.",
    "Desperate Energy": "Recover energy after failed checks or contests.",
    "Energy Drain": "Recover energy whenever this unit deals damage.",
    "Lethal Energy": "Energy spent on damage grants +2 magical damage per rank.",
    Haste: "Spend energy to gain additional actions.",
    "Energy Shield": "Spend energy to block damage to this unit or a visible ally.",
    Health: "Already included in maximum health.",
    Healing: "Restore health to this unit or an ally in its zone.",
    "Extra Healing": "Use Healing additional times each turn.",
    "Magic Healing": "Spend energy to restore health at range.",
    Resistance: "Reduce incoming damage each turn.",
    Evasive: "Gain advantage on defensive rolls.",
    "Physical Damage": "Add physical damage when an attack succeeds.",
    Lethality: "Deal additional damage when attacking with advantage.",
    Retaliation: "Attack back when attacked.",
    "Magic Damage": "Add magical damage when an effect succeeds.",
    Multitarget: "Affect additional targets in the same zone.",
    Range: "Attack into additional zones.",
    Speed: "Move through additional zones.",
    Dash: "Gain additional movements each turn.",
    Momentum: "Add damage after moving before a melee attack.",
    Action: "Already included in available actions.",
    Clutch: "Turn a check into an automatic success; not valid for contests.",
  };
  const savedRoster = (() => {
    try { return JSON.parse(localStorage.getItem(rosterKey) || "[]") as CharacterTemplate[]; }
    catch { return []; }
  })();
  const availableUnits = [...characterTemplates, ...savedRoster.filter((saved) => !characterTemplates.some((template) => template.name === saved.name))];

  function renderMap() {
    const renderedCells = cells.map((cell) => {
      const unit = units.find((candidate) => candidate.cell === cell.index);
      const style = cell.color ? `--zone:${cell.color}` : "";
      const reachable = mode === "play" && selectedUnitId && !unit && movesRemaining > 0;
      return `<button type="button" class="hex${cell.zone ? " painted" : ""}${unit ? ` occupied team-${unit.team.toLowerCase()}` : ""}${unit?.id === selectedUnitId ? " selected" : ""}${reachable ? " reachable" : ""}" style="${style}" data-cell="${cell.index}" title="${cell.zone || "Unpainted hex"}">
        <span class="zone-label">${cell.zone}</span>
        ${unit ? `<span class="unit-token">${unit.name.slice(0, 2).toUpperCase()}</span>` : ""}
      </button>`;
    });
    map.innerHTML = Array.from({ length: 8 }, (_, row) => `<div class="hex-row${row % 2 ? " offset" : ""}">${renderedCells.slice(row * 12, row * 12 + 12).join("")}</div>`).join("");
  }

  function renderDeployment() {
    (["A", "B"] as Team[]).forEach((side) => {
      const list = byId(`team-${side.toLowerCase()}-list`);
      const sideUnits = units.filter((unit) => unit.team === side);
      list.innerHTML = sideUnits.length ? sideUnits.map((unit) => `<li><button type="button" data-unit="${unit.id}">${unit.name}<span>${unit.currentHealth} HP</span></button><button type="button" class="remove-roster-unit" data-remove-unit="${unit.id}" aria-label="Remove ${unit.name}">×</button></li>`).join("") : `<li class="empty">No units deployed</li>`;
    });
  }

  function renderInitiative() {
    byId("round-label").textContent = `Round ${round}`;
    byId("initiative-list").innerHTML = initiative.length
      ? initiative.map((id, index) => {
          const unit = units.find((candidate) => candidate.id === id);
          return unit ? `<button type="button" data-unit="${unit.id}" class="${index === turnIndex ? "active" : ""}"><span>${index + 1}</span>${unit.name}<strong>${unit.initiative}</strong></button>` : "";
        }).join("")
      : `<p class="storage-note">Deploy units, then roll initiative.</p>`;
  }

  function renderSelected() {
    const unit = units.find((candidate) => candidate.id === selectedUnitId);
    byId("selected-name").textContent = unit?.name || "No unit selected";
    if (!unit) {
      byId("selected-unit").innerHTML = `<p class="storage-note">Choose a deployed unit to view its skills, perks, health, and actions.</p>`;
      return;
    }
    const maxHealth = healthFor(unit);
    byId("selected-unit").innerHTML = `
      <div class="unit-vitals"><label>Health <input id="unit-health" type="number" min="0" max="${maxHealth}" value="${unit.currentHealth}"></label><span>/ ${maxHealth}</span></div>
      <div class="unit-vitals"><label>Actions used <input id="unit-actions" type="number" min="0" max="${actionsFor(unit)}" value="${unit.actionsUsed}"></label><span>/ ${actionsFor(unit)}</span></div>
      <p class="unit-meta">Team ${unit.team} · Level ${unit.level} · Movement ${movementFor(unit)} zone${movementFor(unit) === 1 ? "" : "s"} · ${movesRemaining} remaining</p>
      <div class="usable-list">${(["offence", "defence", "tactical"] as const).map((category) => `<div><h3>${category}</h3>${unit.skills.filter((skill) => skill.category === category).map((skill) => `<button type="button" data-skill="${skill.rating}">${skill.name} ${skill.rating}</button>`).join("") || "<span>None</span>"}</div>`).join("")}</div>
      <div class="perk-use-list"><h3>Perks</h3>${unit.perks.map((perk) => `<button type="button" data-perk="${perk.name}">${perk.name}${perk.ranks > 1 ? ` ${perk.ranks}` : ""}</button>`).join("") || "<span>None</span>"}</div>
      <button class="button secondary full-button" id="reset-movement" type="button">Reset movement</button>
      <button class="text-button danger" id="remove-unit" type="button">Remove from battle</button>`;
    byId<HTMLInputElement>("unit-health").addEventListener("change", (event) => {
      unit.currentHealth = Number((event.target as HTMLInputElement).value);
      renderDeployment();
    });
    byId<HTMLInputElement>("unit-actions").addEventListener("change", (event) => unit.actionsUsed = Number((event.target as HTMLInputElement).value));
    byId("selected-unit").querySelectorAll<HTMLButtonElement>("[data-skill]").forEach((button) => button.addEventListener("click", () => {
      if (unit.actionsUsed >= actionsFor(unit)) {
        byId("battle-status").textContent = `${unit.name} has no actions remaining this turn.`;
        return;
      }
      unit.actionsUsed += 1;
      byId<HTMLInputElement>("roll-bonus").value = button.dataset.skill || "0";
      byId("battle-status").textContent = `${unit.name} uses ${button.textContent}. One action spent; roll when ready.`;
      renderSelected();
    }));
    byId("selected-unit").querySelectorAll<HTMLButtonElement>("[data-perk]").forEach((button) => button.addEventListener("click", () => {
      const name = button.dataset.perk || "";
      byId("battle-status").textContent = `${unit.name} uses ${name}: ${perkRules[name] || "Apply the perk's listed effect."}`;
      logActivity(`${unit.name} uses ${name}.`);
    }));
    byId("reset-movement").addEventListener("click", () => {
      movesRemaining = movementFor(unit);
      renderSelected();
      renderMap();
    });
    byId("remove-unit").addEventListener("click", () => {
      units = units.filter((candidate) => candidate.id !== unit.id);
      initiative = initiative.filter((id) => id !== unit.id);
      selectedUnitId = "";
      renderAll();
    });
  }

  function renderAll() {
    renderMap();
    renderDeployment();
    renderInitiative();
    renderSelected();
  }

  document.querySelector(".team-rosters")?.addEventListener("click", (event) => {
    const remove = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-unit]");
    if (remove) {
      const unit = units.find((candidate) => candidate.id === remove.dataset.removeUnit);
      units = units.filter((candidate) => candidate.id !== remove.dataset.removeUnit);
      initiative = initiative.filter((id) => id !== remove.dataset.removeUnit);
      if (selectedUnitId === remove.dataset.removeUnit) selectedUnitId = "";
      if (unit) logActivity(`${unit.name} removed from the battle.`);
      renderAll();
      return;
    }
    const select = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-unit]");
    if (select) {
      selectedUnitId = select.dataset.unit || "";
      const unit = units.find((candidate) => candidate.id === selectedUnitId);
      movesRemaining = unit ? movementFor(unit) : 0;
      renderAll();
    }
  });

  function paintCell(cell: Cell) {
    cell.zone = erasing ? "" : byId<HTMLInputElement>("zone-name").value.trim();
    cell.color = erasing ? "" : byId<HTMLInputElement>("zone-color").value;
  }

  function logActivity(message: string) {
    const entry = document.createElement("li");
    entry.textContent = `R${round}: ${message}`;
    byId("match-log").prepend(entry);
  }

  function handleCell(cellIndex: number) {
    const cell = cells[cellIndex];
    const occupying = units.find((unit) => unit.cell === cell.index);
    if (mode === "paint") {
      paintCell(cell);
    } else if (mode === "deploy" && pendingTemplate && !occupying) {
      const deployed = { ...structuredClone(pendingTemplate), id: crypto.randomUUID(), team, cell: cell.index, currentHealth: healthFor(pendingTemplate), actionsUsed: 0, initiative: 0 };
      units.push(deployed);
      logActivity(`${deployed.name} deployed for Team ${team}.`);
      pendingTemplate = null;
      byId("battle-status").textContent = "Unit deployed. Select another unit or switch to play mode.";
    } else if (occupying) {
      selectedUnitId = occupying.id;
      movesRemaining = movementFor(occupying);
    } else if (mode === "play" && selectedUnitId) {
      const unit = units.find((candidate) => candidate.id === selectedUnitId);
      if (unit && movesRemaining > 0) {
        unit.cell = cell.index;
        movesRemaining -= 1;
        logActivity(`${unit.name} moves to ${cell.zone || `hex ${cell.index + 1}`}.`);
      } else if (unit) {
        byId("battle-status").textContent = `${unit.name} has no movement remaining.`;
      }
    }
    renderAll();
  }

  map.addEventListener("pointerdown", (event) => {
    const hex = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cell]");
    if (!hex) return;
    pointerPainting = mode === "paint";
    handleCell(Number(hex.dataset.cell));
  });
  map.addEventListener("pointerover", (event) => {
    if (!pointerPainting || mode !== "paint") return;
    const hex = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cell]");
    if (hex) {
      paintCell(cells[Number(hex.dataset.cell)]);
      renderMap();
    }
  });
  window.addEventListener("pointerup", () => pointerPainting = false);

  document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => button.addEventListener("click", () => {
    mode = button.dataset.mode as Mode;
    document.querySelectorAll("[data-mode]").forEach((item) => item.classList.toggle("active", item === button));
    byId("deployment-panel").classList.toggle("disabled-panel", mode === "paint");
    byId("battle-status").textContent = mode === "paint" ? "Click and drag across hexes to paint terrain." : mode === "deploy" ? "Choose a team and unit, then click a starting hex." : "Select a unit, then move it one hex at a time up to its movement allowance.";
  }));
  document.querySelectorAll<HTMLButtonElement>("[data-team]").forEach((button) => button.addEventListener("click", () => {
    team = button.dataset.team as Team;
    document.querySelectorAll("[data-team]").forEach((item) => item.classList.toggle("active", item === button));
  }));
  byId("erase-toggle").addEventListener("click", () => {
    erasing = !erasing;
    byId("erase-toggle").textContent = `Eraser ${erasing ? "on" : "off"}`;
  });

  const unitSelect = byId<HTMLSelectElement>("unit-template");
  unitSelect.innerHTML = availableUnits.map((unit, index) => `<option value="${index}">${unit.name} — Level ${unit.level}</option>`).join("");
  byId("select-unit").addEventListener("click", () => {
    pendingTemplate = availableUnits[Number(unitSelect.value)];
    mode = "deploy";
    document.querySelectorAll("[data-mode]").forEach((item) => item.classList.toggle("active", (item as HTMLElement).dataset.mode === "deploy"));
    byId("battle-status").textContent = `Place ${pendingTemplate.name} for Team ${team}.`;
  });

  byId("start-match").addEventListener("click", () => {
    units.forEach((unit) => {
      const tactical = Math.max(0, ...unit.skills.filter((skill) => skill.category === "tactical").map((skill) => skill.rating));
      unit.initiative = Math.ceil(Math.random() * 6) + Math.ceil(Math.random() * 6) + tactical;
      unit.actionsUsed = 0;
    });
    initiative = [...units].sort((a, b) => b.initiative - a.initiative || (a.team === "A" ? -1 : 1)).map((unit) => unit.id);
    turnIndex = 0;
    round = 1;
    selectedUnitId = initiative[0] || "";
    const active = units.find((unit) => unit.id === selectedUnitId);
    movesRemaining = active ? movementFor(active) : 0;
    logActivity("Initiative rolled. Match begins.");
    renderAll();
  });
  byId("next-turn").addEventListener("click", () => {
    if (!initiative.length) return;
    turnIndex += 1;
    if (turnIndex >= initiative.length) {
      turnIndex = 0;
      round += 1;
      units.forEach((unit) => unit.actionsUsed = 0);
    }
    selectedUnitId = initiative[turnIndex];
    const active = units.find((unit) => unit.id === selectedUnitId);
    movesRemaining = active ? movementFor(active) : 0;
    if (active) logActivity(`${active.name}'s turn begins.`);
    renderAll();
  });

  byId("roll-dice").addEventListener("click", () => {
    const dice = [1, 2, 3].map(() => Math.ceil(Math.random() * 6));
    const advantage = byId<HTMLInputElement>("roll-advantage").checked;
    const kept = advantage ? dice.sort((a, b) => b - a).slice(0, 2) : dice.slice(0, 2);
    const bonus = Number(byId<HTMLInputElement>("roll-bonus").value) || 0;
    const total = kept[0] + kept[1] + bonus;
    byId("dice-result").innerHTML = `<strong>${total}</strong><span>${kept.join(" + ")}${bonus ? ` + ${bonus}` : ""}${advantage ? " (advantage)" : ""}</span>`;
    const entry = document.createElement("li");
    entry.textContent = `${total}: ${kept.join(" + ")}${bonus ? ` + ${bonus}` : ""}`;
    byId("roll-log").prepend(entry);
    logActivity(`Rolled ${total}${bonus ? ` with +${bonus}` : ""}.`);
  });

  byId("save-battle").addEventListener("click", () => {
    localStorage.setItem(storageKey, JSON.stringify({ cells, units, initiative, turnIndex, round }));
    byId("battle-status").textContent = "Battle saved in this browser.";
  });
  byId("new-battle").addEventListener("click", () => {
    if (!confirm("Clear the current map and battle?")) return;
    cells.forEach((cell) => Object.assign(cell, { zone: "", color: "" }));
    units = []; initiative = []; turnIndex = 0; round = 1; selectedUnitId = "";
    localStorage.removeItem(storageKey);
    renderAll();
  });

  function loadMaps() {
    try { return JSON.parse(localStorage.getItem(mapsKey) || "[]") as { id: string; name: string; cells: Cell[] }[]; }
    catch { return []; }
  }
  function renderMaps() {
    const maps = loadMaps();
    byId("saved-map-list").innerHTML = maps.length ? maps.map((saved) => `<div><strong>${saved.name}</strong><span>${saved.cells.filter((cell) => cell.zone).length} painted hexes</span><button type="button" data-load-map="${saved.id}">Load</button><button type="button" class="danger" data-delete-map="${saved.id}">Delete</button></div>`).join("") : `<p class="storage-note">No saved maps yet.</p>`;
  }
  byId("save-map").addEventListener("click", () => {
    const name = byId<HTMLInputElement>("map-name").value.trim();
    if (!name) return void (byId("battle-status").textContent = "Name the map before saving.");
    const maps = loadMaps();
    const existing = maps.find((saved) => saved.name.toLowerCase() === name.toLowerCase());
    const savedMap = { id: existing?.id || crypto.randomUUID(), name, cells: structuredClone(cells) };
    const next = existing ? maps.map((saved) => saved.id === existing.id ? savedMap : saved) : [savedMap, ...maps];
    localStorage.setItem(mapsKey, JSON.stringify(next));
    byId("battle-status").textContent = `Map "${name}" saved.`;
    renderMaps();
  });
  byId("saved-map-list").addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
    if (!button) return;
    let maps = loadMaps();
    if (button.dataset.loadMap) {
      const saved = maps.find((map) => map.id === button.dataset.loadMap);
      saved?.cells.forEach((cell, index) => Object.assign(cells[index], cell));
      if (saved) byId<HTMLInputElement>("map-name").value = saved.name;
      renderMap();
    } else if (button.dataset.deleteMap) {
      maps = maps.filter((map) => map.id !== button.dataset.deleteMap);
      localStorage.setItem(mapsKey, JSON.stringify(maps));
      renderMaps();
    }
  });

  try {
    const saved = JSON.parse(localStorage.getItem(storageKey) || "null");
    if (saved) {
      saved.cells?.forEach((cell: Cell, index: number) => Object.assign(cells[index], cell));
      units = saved.units || []; initiative = saved.initiative || []; turnIndex = saved.turnIndex || 0; round = saved.round || 1;
    }
  } catch {}
  renderAll();
  renderMaps();
</script>
